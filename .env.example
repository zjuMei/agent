# 使用支持 Chat Completions Function Calling 的兼容服务和模型。
LLM_API_KEY=
# 填写服务商提供的完整 API 基础地址（通常以 /v1 结尾）。
LLM_BASE_URL=
LLM_MODEL=
# 所有阶段共用同一套生成配置。思考开关是阿里云/Qwen 扩展参数。
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=1536
# 模型请求超时（秒），默认 60；SDK 最多自动重试 1 次。
LLM_TIMEOUT=60
TAVILY_API_KEY=
